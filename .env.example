# https://my.telegram.org -> API development tools. Bo'sh qoldirsangiz MOCK rejim ishlaydi.
TG_API_ID=
TG_API_HASH=
# Sessiyani shifrlash uchun kamida 32 belgili tasodifiy matn
SESSION_SECRET=change-me-to-a-long-random-string-32chars
PORT=4000
WEB_ORIGIN=http://localhost:3001
MAX_UPLOAD_MB=50
# Deploy qilsangiz MAJBURIY: kamida 8 belgi. Ilova kirishdan oldin shu kodni so'raydi.
ACCESS_TOKEN=
# Sinov/E2E uchun (odatda tegmang)
MOCK_REALTIME_MS=12000
AUTH_RATE_LIMIT=30
# Premium (faqat shu ilova ichida; Telegram Premium emas)
PREMIUM_TRIAL_MONTHS=2
PREMIUM_UPLOAD_MB=200
PREMIUM_PRICE=29 000 so'm / oy
# Kod sotib olish uchun havola (masalan, sizning Telegram profilingiz). Bo'sh bo'lsa ko'rsatilmaydi.
PREMIUM_BUY_URL=
